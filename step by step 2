  const galleryState = {};

    function showImage(step, index) {
      const images = document.querySelectorAll(`.gallery-img[data-step='${step}']`);
      images.forEach((img, i) => img.classList.toggle('active', i === index));
      const caption = document.getElementById(`text${step}`);
      if (caption) caption.innerText = imageTexts[step][index];
      galleryState[step] = index;

      const prevBtn = document.querySelector(`button[onclick='prevImage(${step})']`);
      const nextBtn = document.querySelector(`button[onclick='nextImage(${step})']`);
      if (prevBtn) prevBtn.disabled = index === 0;
      if (nextBtn) nextBtn.disabled = index === imageTexts[step].length - 1;
    }

    function nextImage(step) {
      const current = galleryState[step] || 0;
      if (current < imageTexts[step].length - 1) showImage(step, current + 1);
    }

    function prevImage(step) {
      const current = galleryState[step] || 0;
      if (current > 0) showImage(step, current - 1);
    }

    Object.keys(imageTexts).forEach(step => showImage(Number(step), 0));

function switchView(viewId) {
  const views = ['agent', 'shipper', 'driver'];

  // Toggle content views
  views.forEach(v => {
    const contentView = document.getElementById(v);
    if (contentView) {
      contentView.style.display = (v === viewId) ? 'block' : 'none';
    }
  });

  // Toggle sidebar links
  views.forEach(v => {
    const sidebarLinks = document.getElementById(`sidebar-links-${v}`);
    if (sidebarLinks) {
      sidebarLinks.style.display = (v === viewId) ? 'flex' : 'none';
    }
  });

  // Highlight the active button
  const buttons = document.querySelectorAll('.menu-btn');
  buttons.forEach(btn => {
    btn.classList.toggle('active', btn.textContent.toLowerCase().includes(viewId));
  });
}
